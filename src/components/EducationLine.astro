---
import { education } from "../utils/education"
import EducationCard from "./EducationCard.astro"
---

<div class="flex flex-col items-baseline my-7 sm:self-center md:self-center lg:self-start">
    {education && education.map((item) => (
        <EducationCard
        title={item?.title} 
        subtitle={item?.subtitle} 
        date={item?.date} 
        />
    ))}
</div>