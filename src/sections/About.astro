---
import SubTitle from "../components/SubTitle.astro"

const title = 'About me'
const about = `I am a Software Developer specializing in frontend engineering and full-stack solutions, with 3 years of experience building scalable, high-performance applications. My engineering approach focuses on transforming complex UI/UX designs into optimized, production-ready code, bridging the gap between seamless user experiences and robust backend systems.`
---

<article class="flex flex-col justify-center items-center gap-3.5 px-2.5 py-8 lg:justify-start lg:items-start">
     <SubTitle content={title} />
    <div class="text-[#b8c1ec] text-xl text-center font-normal font-sans text-wrap w-fit lg:text-start">
        { about }
    </div>
</article>